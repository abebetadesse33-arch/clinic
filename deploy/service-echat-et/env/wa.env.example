# WA / Ethiopian Wisdom. NEXT_PUBLIC_BASE_PATH is read at BUILD time: build with it, then run.
NODE_ENV=production
PORT=3005
NEXT_PUBLIC_BASE_PATH=/wa
APP_URL=https://service.echat.et/wa              # links in emails, Telegram and payment returns
NEXT_PUBLIC_SCHOOL_APP_URL=https://service.echat.et/school
AUTH_SECRET=CHANGE_ME
DATABASE_URL=mysql://wa_app:CHANGE_ME@10.180.50.142:3306/afriet_wa
DB_TABLE_PREFIX=                                  # empty: the app has its own schema
DB_AUTO_SETUP=off                                 # run `npm run db:setup` explicitly instead

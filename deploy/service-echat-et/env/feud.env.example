# Feud. NEXT_PUBLIC_BASE_PATH is read at BUILD time (and by server.js for the socket.io path).
NODE_ENV=production
PORT=3333
NEXT_PUBLIC_BASE_PATH=/feud
APP_URL=https://service.echat.et/feud
NEXT_PUBLIC_APP_URL=https://service.echat.et/feud
FEUD_HOSTED=1
FEUD_PROTOCOL=https
FEUD_WEBSOCKETS=1                                 # nginx passes WebSocket upgrades on /feud/socket.io
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
DATABASE_URL=mysql://feud_app:CHANGE_ME@10.180.50.142:3306/afriet_feud
DB_TABLE_PREFIX=feud_

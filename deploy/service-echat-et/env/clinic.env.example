# Clinic / NiniMed: set in the Plesk Node.js environment panel (or the process manager). Never commit real values.
NODE_ENV=production
PORT=3001
DATABASE_URL=mysql://clinic_app:CHANGE_ME@10.180.50.142:3306/afriet_clinic   # URL-encode special characters in the password
NEXT_PUBLIC_APP_URL=https://service.echat.et/health
NINIMED_AUTO_MIGRATE=false          # schema is applied with scripts/db-migrate.ts, not on boot
NINIMED_COOKIE_PATH=/health         # Nini_session is only sent to /health/...
NINIMED_LEGACY_APP_REDIRECTS=false  # nginx routes /school /feud /paraphrase /wa

# ==========================================
# Nini CLINICAL ENTERPRISE - ENVIRONMENT
# ==========================================
# =============================================================================
# NiniMed Enterprise CDSS - Environment Template
# =============================================================================
# Copy this file to .env for local Docker development or configure the same
# variables in Plesk under the Node.js application's environment settings.
# Never commit .env, .env.production, passwords, API keys, or private keys.
#
# Local Docker defaults:
#   DATABASE_URL=postgres://postgres:postgres@postgres:5432/clinic_enterprise
#   REDIS_URL=redis://redis:6379
#
# Plesk production values must use the hostname, database, and Redis service
# reachable from the Plesk server. Do not use the Docker hostnames there unless
# PostgreSQL and Redis are running in the same Docker network.
# =============================================================================

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public canonical URL used in links, callbacks, FHIR metadata, and Telegram.
# Local: http://localhost:3000
# Production: https://app.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional public API origin. Leave empty when the API is served by this app.
NEXT_PUBLIC_API_URL=

# Values displayed in the UI and application metadata.
NEXT_PUBLIC_APP_NAME="NiniMed Enterprise CDSS"
NEXT_PUBLIC_APP_VERSION="3.0.0-enterprise"

# Optional public Android package download URL.
NEXT_PUBLIC_ANDROID_APK_URL=

# -----------------------------------------------------------------------------
# PostgreSQL and Redis
# -----------------------------------------------------------------------------
# Docker Compose defaults use service names; local non-Docker development uses
# localhost instead. Use a strong password in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic_enterprise
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Google Gemini AI
# -----------------------------------------------------------------------------
# The *_1, *_2, *_3 pool is tried in order by the Gemini REST client and can
# rotate after provider failures. At least one key is required for AI features.
# Keep these server-only. Never use a real key in this template.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Legacy client-side fallback names are retained by some AI helpers. Do not set
# these in production because NEXT_PUBLIC_* values are exposed to browsers.
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional alternate AI providers used by the clinical AI query endpoint.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Telegram notifications
# -----------------------------------------------------------------------------
# Server-only bot token. The username is safe to expose in the UI.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Ninimedbot

# -----------------------------------------------------------------------------
# Cryptographic integrity and security
# -----------------------------------------------------------------------------
# Required in production. Generate unique random values and store them only in
# the server environment. Changing them later can invalidate encrypted data or
# audit verification, so rotate them through a planned migration.
ENCRYPTION_MASTER_KEY=replace-with-a-long-random-production-secret
AUDIT_HMAC_SECRET=replace-with-a-long-random-audit-secret

# -----------------------------------------------------------------------------
# Build and database initialization flags
# -----------------------------------------------------------------------------
# These are normally managed by Next.js and the deployment platform. Keep them
# unset for ordinary development and production runtime.
NEXT_PHASE=
NEXT_IS_EXPORTING=

# =============================================================================
# Plesk / GitHub Actions deployment secrets
# =============================================================================
# Do not put these in .env or the repository. Configure them as GitHub Actions
# repository secrets instead:
#
# PLESK_HOST
# PLESK_USERNAME
# PLESK_PASSWORD
# PLESK_SSH_PORT (optional; defaults to 22)
# PLESK_DEPLOY_PATH
# PLESK_DOMAIN
#
# NEXT_PUBLIC_APP_URL and NEXT_PUBLIC_API_URL are also required as GitHub
# Actions secrets when their production values are needed at build time.
# =============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection String (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic_enterprise

# Redis Cache & Message Queue
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────
# Google Gemini API Key Pool (REST Failover)
# All three keys are tried in order on 429/5xx.
# Keys rotate round-robin; each failed key cools down for 60s.
# ──────────────────────────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# App Metadata
NEXT_PUBLIC_APP_NAME="NiniMed Enterprise CDSS"
NEXT_PUBLIC_APP_VERSION="3.0.0-enterprise"

# -----------------------------------------------------------------------------
# Appointment Reminder Cron
# Secret token to secure GET /api/v1/notifications/reminder-cron
# Set this to a long random string (e.g. openssl rand -hex 32)
# Call every 5 minutes: curl "https://yourdomain/api/v1/notifications/reminder-cron?secret=<value>"
# -----------------------------------------------------------------------------
CRON_SECRET=


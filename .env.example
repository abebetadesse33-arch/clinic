# ==========================================
# Nini CLINICAL ENTERPRISE - ENVIRONMENT
# ==========================================

# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection String (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic_enterprise

# Redis Cache & Message Queue
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────
# Google Gemini API Key Pool (REST Failover)
# All three keys are tried in order on 429/5xx.
# Keys rotate round-robin; each failed key cools down for 60s.
# ──────────────────────────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# App Metadata
NEXT_PUBLIC_APP_NAME="NiniMed Enterprise CDSS"
NEXT_PUBLIC_APP_VERSION="3.0.0-enterprise"
